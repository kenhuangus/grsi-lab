{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grsi.lab/schemas/delegation_channel.schema.json",
  "title": "DelegationChannel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "channel_id",
    "delegator_lineage_id",
    "specialist_role",
    "inherited_sandbox_profile_id",
    "evaluation_gates",
    "bypass_sandbox",
    "bypass_sealed_ledger"
  ],
  "properties": {
    "channel_id": { "type": "string", "minLength": 1 },
    "delegator_lineage_id": {
      "type": "string",
      "format": "uuid"
    },
    "specialist_role": { "type": "string", "minLength": 1 },
    "inherited_sandbox_profile_id": { "type": "string", "minLength": 1 },
    "evaluation_gates": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "bypass_sandbox": {
      "type": "boolean",
      "const": false,
      "description": "Delegation must not bypass sandbox"
    },
    "bypass_sealed_ledger": {
      "type": "boolean",
      "const": false,
      "description": "Delegation must not bypass sealed ledger"
    },
    "egress_broker_ref": { "type": "string" }
  }
}
