{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grsi.lab/schemas/metric_card.schema.json",
  "title": "MetricCard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card_id",
    "held_in",
    "held_out",
    "multi_seed",
    "module_ablation",
    "token_roi"
  ],
  "properties": {
    "card_id": { "type": "string", "minLength": 1 },
    "held_in": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_ref", "metric_name"],
      "properties": {
        "dataset_ref": { "type": "string", "minLength": 1 },
        "metric_name": { "type": "string", "minLength": 1 }
      }
    },
    "held_out": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_ref", "metric_name"],
      "properties": {
        "dataset_ref": { "type": "string", "minLength": 1 },
        "metric_name": { "type": "string", "minLength": 1 }
      }
    },
    "multi_seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seeds", "aggregate"],
      "properties": {
        "seeds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer" }
        },
        "aggregate": {
          "type": "string",
          "enum": ["mean", "median", "min"]
        }
      }
    },
    "module_ablation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules", "required"],
      "properties": {
        "modules": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "required": { "type": "boolean" }
      }
    },
    "token_roi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "string", "minLength": 1 },
        "denominator": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
