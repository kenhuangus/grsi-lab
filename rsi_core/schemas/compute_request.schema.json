{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grsi.lab/schemas/compute_request.schema.json",
  "title": "ComputeRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["budget", "target_metric", "stop_rule", "lineage_id"],
  "properties": {
    "lineage_id": {
      "type": "string",
      "format": "uuid"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "amount"],
      "properties": {
        "units": {
          "type": "string",
          "enum": ["gpu_hours", "tokens", "wall_seconds", "dollars"]
        },
        "amount": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "target_metric": { "type": "string", "minLength": 1 },
    "stop_rule": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  }
}
