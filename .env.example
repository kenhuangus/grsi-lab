# Optional maintainer tooling for Google Docs publishing (not required for labs/tests).
# Copy to .env locally; never commit real credentials.

GOOGLE_WORKSPACE_CLI_ACCOUNT=
GOOGLE_WORKSPACE_CLI_CONFIG_DIR=
# Example Windows npm shim (override as needed):
# GWS_CMD=C:\Users\You\AppData\Roaming\npm\gws.cmd

# Production HMAC key for promotion tokens (base64, >=32 bytes). Required outside local labs.
# GRSI_PROMOTION_HMAC_KEY=
